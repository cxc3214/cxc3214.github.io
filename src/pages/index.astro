---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
import { topics, formatDate } from "../config/topics";

const posts = (await getCollection("blog")).sort((a, b) =>
  (b.data.updated ?? b.data.date).valueOf() - (a.data.updated ?? a.data.date).valueOf());
const featured = posts.find((post) => post.id === "json-formatting-data-fidelity")!;
const latest = posts.filter((post) => post.id !== featured.id).slice(0, 4);
const jsonLd = {
  "@context": "https://schema.org", "@type": "WebSite",
  name: siteConfig.title, url: siteConfig.url, description: siteConfig.description,
  author: { "@type": "Person", name: siteConfig.author, url: `${siteConfig.url}/about/` },
};
---

<BaseLayout title={siteConfig.title} description={siteConfig.description} jsonLd={jsonLd}>
  <section class="hero editorial-hero">
    <div class="hero-copy">
      <p class="hero-kicker">Spring / 独立开发笔记</p>
      <h1>把项目里的问题，<br />写成能用的笔记。</h1>
      <p class="lead">从一个静态网站的发布，到一个 APK 的校验。这里记录具体的配置、取舍与验证方法，也说明哪些结论还需要继续验证。</p>
      <div class="actions">
        <a class="button" href="/blog/">阅读全部文章</a>
        <a class="button-secondary" href="/about/">关于作者与写作</a>
      </div>
    </div>
    <aside class="panel reading-pick" aria-label="推荐阅读">
      <p class="eyebrow">从这篇开始 / {featured.data.kind}</p>
      <h2><a href={`/blog/${featured.id}/`}>{featured.data.title}</a></h2>
      <p>{featured.data.description}</p>
      <a class="text-link" href={`/blog/${featured.id}/`}>阅读完整笔记 →</a>
    </aside>
  </section>
  <section class="section" aria-labelledby="topics-title">
    <div class="section-header"><div><p class="eyebrow">按问题找文章</p><h2 id="topics-title">三个阅读方向</h2></div></div>
    <div class="manifesto-grid">
      {topics.map((topic) => <article class="project-card topic-card">
        <p class="eyebrow">{posts.filter((post) => post.data.topic === topic.id).length} 篇笔记</p>
        <h3><a href={`/blog/#${topic.id}`}>{topic.name}</a></h3>
        <p>{topic.description}</p><a href={`/blog/#${topic.id}`}>查看这个主题 →</a>
      </article>)}
    </div>
  </section>
  <section class="section" aria-labelledby="recent-title">
    <div class="section-header"><div><p class="eyebrow">按最近修订排序</p><h2 id="recent-title">最近的笔记</h2></div><a href="/blog/">全部 {posts.length} 篇</a></div>
    <div class="post-list">
      {latest.map((post, index) => <article class="post-card" data-index={String(index + 1).padStart(2, "0")}>
        <div class="meta"><span>{post.data.kind}</span><time datetime={(post.data.updated ?? post.data.date).toISOString()}>{post.data.updated ? "修订" : "发布"} {formatDate(post.data.updated ?? post.data.date)}</time></div>
        <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
        <p>{post.data.description}</p>
        <div class="meta">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
      </article>)}
    </div>
  </section>
  <section class="section home-projects" aria-labelledby="projects-title">
    <div><p class="eyebrow">笔记背后的项目</p><h2 id="projects-title">继续动手试试</h2><p>应用有独立的功能介绍、版本信息和隐私说明。外部工具站有各自的使用范围，文章里的示例不等于所有项目的线上实现。</p></div>
    <div class="project-links"><a href="/apps/tingban/">听伴 · 助听与对话整理 →</a><a href="/apps/routedeck/">RouteDeck · Android 桌面 →</a><a href="/projects/">工具网站与项目说明 →</a></div>
  </section>
</BaseLayout>
