{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imspring-study",
  "main": "workers/study.mjs",
  "compatibility_date": "2026-04-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "imspring.cn/study", "zone_name": "imspring.cn" },
    { "pattern": "imspring.cn/study/*", "zone_name": "imspring.cn" },
    { "pattern": "www.imspring.cn/study", "zone_name": "imspring.cn" },
    { "pattern": "www.imspring.cn/study/*", "zone_name": "imspring.cn" }
  ],
  "assets": {
    "directory": ".study-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
