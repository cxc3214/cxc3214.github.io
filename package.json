{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:study",
    "build:study": "node scripts/build-study.mjs",
    "dev:study": "npm run build:study && wrangler dev --config wrangler.study.jsonc --port 8787 --host localhost",
    "deploy:study": "npm run build:study && wrangler deploy --config wrangler.study.jsonc",
    "generate:qrs": "node scripts/generate-app-qrs.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:built": "node scripts/verify-built-site.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.7",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.8"
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "satteri": "^0.10.5",
    "wrangler": "4.151.0"
  }
}
